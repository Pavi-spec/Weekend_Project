<?xml version="1.0" encoding="UTF-8"?>

<jcr:root
        xmlns:sling="http://sling.apache.org/jcr/sling/1.0"
        xmlns:cq="http://www.day.com/jcr/cq/1.0"
        xmlns:jcr="http://www.jcp.org/jcr/1.0"
        xmlns:nt="http://www.jcp.org/jcr/nt/1.0"
        jcr:primaryType="nt:unstructured"

        jcr:title="Bus Reservation"
        sling:resourceType="cq/gui/components/authoring/dialog">

    <content
            jcr:primaryType="nt:unstructured"
            sling:resourceType=
                    "granite/ui/components/coral/foundation/container">

        <items jcr:primaryType="nt:unstructured">

            <tabs
                    jcr:primaryType="nt:unstructured"
                    sling:resourceType=
                            "granite/ui/components/coral/foundation/tabs">

                <items jcr:primaryType="nt:unstructured">

                    <basic
                            jcr:primaryType="nt:unstructured"
                            jcr:title="Bus Details"
                            sling:resourceType=
                                    "granite/ui/components/coral/foundation/container">

                        <items jcr:primaryType="nt:unstructured">

                            <!-- TITLE -->
                            <title
                                    jcr:primaryType="nt:unstructured"
                                    sling:resourceType=
                                            "granite/ui/components/coral/foundation/form/textfield"
                                    fieldLabel="Bus Title"
                                    name="./title"/>

                            <!-- DESCRIPTION -->
                            <description
                                    jcr:primaryType="nt:unstructured"
                                    sling:resourceType=
                                            "granite/ui/components/coral/foundation/form/textarea"
                                    fieldLabel="Description"
                                    name="./description"/>

                            <!-- IMAGE -->
                            <image
                                    jcr:primaryType="nt:unstructured"
                                    sling:resourceType=
                                            "granite/ui/components/coral/foundation/form/pathfield"
                                    fieldLabel="Bus Image"
                                    name="./image"
                                    rootPath="/content/dam"/>

                            <!-- FROM -->
                            <from
                                    jcr:primaryType="nt:unstructured"
                                    sling:resourceType=
                                            "granite/ui/components/coral/foundation/form/textfield"
                                    fieldLabel="From"
                                    name="./from"/>

                            <!-- TO -->
                            <to
                                    jcr:primaryType="nt:unstructured"
                                    sling:resourceType=
                                            "granite/ui/components/coral/foundation/form/textfield"
                                    fieldLabel="To"
                                    name="./to"/>

                            <!-- DATE -->
                            <date
                                    jcr:primaryType="nt:unstructured"
                                    sling:resourceType=
                                            "granite/ui/components/coral/foundation/form/datepicker"
                                    fieldLabel="Travel Date"
                                    name="./date"/>

                            <!-- PRICE -->
                            <price
                                    jcr:primaryType="nt:unstructured"
                                    sling:resourceType=
                                            "granite/ui/components/coral/foundation/form/numberfield"
                                    fieldLabel="Price"
                                    name="./price"/>

                            <!-- SEATS -->
                            <seats
                                    jcr:primaryType="nt:unstructured"
                                    sling:resourceType=
                                            "granite/ui/components/coral/foundation/form/numberfield"
                                    fieldLabel="Available Seats"
                                    name="./seats"/>

                            <!-- AC -->
                            <ac
                                    jcr:primaryType="nt:unstructured"
                                    sling:resourceType=
                                            "granite/ui/components/coral/foundation/form/checkbox"
                                    text="AC Available"
                                    name="./ac"/>

                            <!-- BUTTON TEXT -->
                            <buttonText
                                    jcr:primaryType="nt:unstructured"
                                    sling:resourceType=
                                            "granite/ui/components/coral/foundation/form/textfield"
                                    fieldLabel="Button Text"
                                    name="./buttonText"/>

                            <!-- BUTTON LINK -->
                            <buttonLink
                                    jcr:primaryType="nt:unstructured"
                                    sling:resourceType=
                                            "granite/ui/components/coral/foundation/form/pathfield"
                                    fieldLabel="Button Link"
                                    name="./buttonLink"/>

                        </items>

                    </basic>

                </items>

            </tabs>

        </items>

    </content>

</jcr:root>