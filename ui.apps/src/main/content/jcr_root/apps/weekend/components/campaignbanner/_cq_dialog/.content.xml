<?xml version="1.0" encoding="UTF-8"?>
<jcr:root
        xmlns:sling="http://sling.apache.org/jcr/sling/1.0"
        xmlns:granite="http://www.adobe.com/jcr/granite/1.0"
        xmlns:cq="http://www.day.com/jcr/cq/1.0"
        xmlns:jcr="http://www.jcp.org/jcr/1.0"
        xmlns:nt="http://www.jcp.org/jcr/nt/1.0"
        jcr:primaryType="nt:unstructured"
        jcr:title="Campaign Banner"
        sling:resourceType="cq/gui/components/authoring/dialog">

    <content
            jcr:primaryType="nt:unstructured"
            sling:resourceType="granite/ui/components/coral/foundation/container">

        <items jcr:primaryType="nt:unstructured">

            <tabs
                    jcr:primaryType="nt:unstructured"
                    sling:resourceType="granite/ui/components/coral/foundation/tabs"
                    maximized="{Boolean}false">

                <items jcr:primaryType="nt:unstructured">



                    <campaign
                            jcr:primaryType="nt:unstructured"
                            jcr:title="Campaign"
                            sling:resourceType="granite/ui/components/coral/foundation/container"
                            margin="{Boolean}true">

                        <items jcr:primaryType="nt:unstructured">

                            <columns
                                    jcr:primaryType="nt:unstructured"
                                    sling:resourceType="granite/ui/components/coral/foundation/fixedcolumns"
                                    margin="{Boolean}true">

                                <items jcr:primaryType="nt:unstructured">

                                    <column
                                            jcr:primaryType="nt:unstructured"
                                            sling:resourceType="granite/ui/components/coral/foundation/container">

                                        <items jcr:primaryType="nt:unstructured">


                                            <campaignName
                                                    jcr:primaryType="nt:unstructured"
                                                    sling:resourceType="granite/ui/components/coral/foundation/form/textfield"
                                                    fieldLabel="Campaign Name"
                                                    fieldDescription="Enter the name of the campaign"
                                                    emptyText="Enter campaign name"
                                                    name="./campaignName"
                                                    required="{Boolean}true"/>




                                            <campaignTitle
                                                    jcr:primaryType="nt:unstructured"
                                                    sling:resourceType="granite/ui/components/coral/foundation/form/textfield"
                                                    fieldLabel="Campaign Title"
                                                    fieldDescription="Enter the main title of the campaign"
                                                    emptyText="Enter campaign title"
                                                    name="./campaignTitle"
                                                    required="{Boolean}true"/>




                                            <campaignDescription
                                                    jcr:primaryType="nt:unstructured"
                                                    sling:resourceType="granite/ui/components/coral/foundation/form/textarea"
                                                    fieldLabel="Campaign Description"
                                                    fieldDescription="Enter a short description"
                                                    name="./campaignDescription"/>


                                            <campaignContent
                                                    jcr:primaryType="nt:unstructured"
                                                    sling:resourceType="cq/gui/components/coral/foundation/form/richtext"
                                                    fieldLabel="Campaign Content"
                                                    name="./campaignContent"
                                                    useFixedInlineToolbar="{Boolean}true"/>

                                            <ctaText
                                                    jcr:primaryType="nt:unstructured"
                                                    sling:resourceType="granite/ui/components/coral/foundation/form/textfield"
                                                    fieldLabel="CTA Text"
                                                    fieldDescription="Enter button text"
                                                    emptyText="Enter button text"
                                                    name="./ctaText"/>



                                            <ctaLink
                                                    jcr:primaryType="nt:unstructured"
                                                    sling:resourceType="granite/ui/components/coral/foundation/form/pathfield"
                                                    fieldLabel="CTA Link"
                                                    fieldDescription="Select the page for the CTA"
                                                    name="./ctaLink"
                                                    rootPath="/content"/>

                                        </items>

                                    </column>

                                </items>

                            </columns>

                        </items>

                    </campaign>




                    <configuration
                            jcr:primaryType="nt:unstructured"
                            jcr:title="Banner Configuration"
                            sling:resourceType="granite/ui/components/coral/foundation/container"
                            margin="{Boolean}true">

                        <items jcr:primaryType="nt:unstructured">

                            <columns
                                    jcr:primaryType="nt:unstructured"
                                    sling:resourceType="granite/ui/components/coral/foundation/fixedcolumns"
                                    margin="{Boolean}true">

                                <items jcr:primaryType="nt:unstructured">

                                    <column
                                            jcr:primaryType="nt:unstructured"
                                            sling:resourceType="granite/ui/components/coral/foundation/container">

                                        <items jcr:primaryType="nt:unstructured">



                                            <bannerImage
                                                    jcr:primaryType="nt:unstructured"
                                                    sling:resourceType="cq/gui/components/authoring/dialog/fileupload"
                                                    allowUpload="{Boolean}false"
                                                    autoStart="{Boolean}false"
                                                    class="cq-droptarget"
                                                    fieldLabel="Banner Image"
                                                    fileNameParameter="./fileName"
                                                    fileReferenceParameter="./bannerImage"
                                                    mimeTypes="[image/gif,image/jpeg,image/png,image/tiff,image/svg+xml]"
                                                    multiple="{Boolean}false"
                                                    name="./file"
                                                    title="Select Banner Image"
                                                    uploadUrl="${suffix.path}"
                                                    useHTML5="{Boolean}true"/>




                                            <bannerSize
                                                    jcr:primaryType="nt:unstructured"
                                                    sling:resourceType="granite/ui/components/coral/foundation/form/radiogroup"
                                                    fieldLabel="Banner Size"
                                                    name="./bannerSize"
                                                    vertical="{Boolean}true">

                                                <items jcr:primaryType="nt:unstructured">

                                                    <small
                                                            jcr:primaryType="nt:unstructured"
                                                            checked="{Boolean}true"
                                                            text="Small"
                                                            value="small"/>

                                                    <medium
                                                            jcr:primaryType="nt:unstructured"
                                                            text="Medium"
                                                            value="medium"/>

                                                    <large
                                                            jcr:primaryType="nt:unstructured"
                                                            text="Large"
                                                            value="large"/>

                                                </items>

                                            </bannerSize>




                                            <bannerStyle
                                                    jcr:primaryType="nt:unstructured"
                                                    sling:resourceType="granite/ui/components/coral/foundation/form/select"
                                                    fieldLabel="Banner Style"
                                                    name="./bannerStyle">

                                                <items jcr:primaryType="nt:unstructured">

                                                    <fullWindow
                                                            jcr:primaryType="nt:unstructured"
                                                            text="Full Window"
                                                            value="FULL_WINDOW"/>

                                                    <sizedContainer
                                                            jcr:primaryType="nt:unstructured"
                                                            text="Sized Container"
                                                            value="SIZED_CONTAINER"/>

                                                    <inline
                                                            jcr:primaryType="nt:unstructured"
                                                            text="In-Line"
                                                            value="IN_LINE"/>

                                                </items>

                                            </bannerStyle>




                                            <bannerPriority
                                                    jcr:primaryType="nt:unstructured"
                                                    sling:resourceType="granite/ui/components/coral/foundation/form/numberfield"
                                                    fieldLabel="Banner Priority"
                                                    fieldDescription="Enter the priority of the banner"
                                                    defaultValue="1"
                                                    min="1"
                                                    max="100"
                                                    step="1"
                                                    name="./bannerPriority"/>




                                            <enableCta
                                                    jcr:primaryType="nt:unstructured"
                                                    sling:resourceType="granite/ui/components/coral/foundation/form/checkbox"
                                                    fieldDescription="Enable the CTA button"
                                                    name="./enableCta"
                                                    text="Enable CTA"
                                                    checked="{Boolean}true"
                                                    uncheckedValue="{Boolean}false"
                                                    value="{Boolean}true"/>



                                            <startDate
                                                    jcr:primaryType="nt:unstructured"
                                                    sling:resourceType="granite/ui/components/coral/foundation/form/datepicker"
                                                    displayedFormat="MM-DD-YYYY HH:mm"
                                                    fieldLabel="Campaign Start Date"
                                                    name="./startDate"
                                                    type="datetime"
                                                    typeHint="Date"/>




                                            <endDate
                                                    jcr:primaryType="nt:unstructured"
                                                    sling:resourceType="granite/ui/components/coral/foundation/form/datepicker"
                                                    displayedFormat="MM-DD-YYYY HH:mm"
                                                    fieldLabel="Campaign End Date"
                                                    name="./endDate"
                                                    type="datetime"
                                                    typeHint="Date"/>

                                        </items>

                                    </column>

                                </items>

                            </columns>

                        </items>

                    </configuration>




                    <additionalConfiguration
                            jcr:primaryType="nt:unstructured"
                            jcr:title="Additional Configuration"
                            sling:resourceType="granite/ui/components/coral/foundation/container"
                            margin="{Boolean}true">

                        <items jcr:primaryType="nt:unstructured">

                            <columns
                                    jcr:primaryType="nt:unstructured"
                                    sling:resourceType="granite/ui/components/coral/foundation/fixedcolumns"
                                    margin="{Boolean}true">

                                <items jcr:primaryType="nt:unstructured">

                                    <column
                                            jcr:primaryType="nt:unstructured"
                                            sling:resourceType="granite/ui/components/coral/foundation/container">

                                        <items jcr:primaryType="nt:unstructured">


                                            <campaignPage
                                                    jcr:primaryType="nt:unstructured"
                                                    sling:resourceType="granite/ui/components/coral/foundation/form/pathbrowser"
                                                    fieldLabel="Campaign Page"
                                                    fieldDescription="Select the campaign page"
                                                    name="./campaignPage"
                                                    required="{Boolean}true"
                                                    rootPath="/content"/>

                                            <additionalSettings
                                                    jcr:primaryType="nt:unstructured"
                                                    sling:resourceType="granite/ui/components/coral/foundation/form/textarea"
                                                    fieldLabel="Additional Settings"
                                                    fieldDescription="Enter any additional campaign settings"
                                                    name="./additionalSettings"/>

                                        </items>

                                    </column>

                                </items>

                            </columns>

                        </items>

                    </additionalConfiguration>

                </items>

            </tabs>

        </items>

    </content>

</jcr:root>